# GitHub PAT with read access to the repositories you review (repo scope read).
GITHUB_TOKEN=your_github_token_here

# Claude authentication — provide exactly ONE of the following.
# Recommended: a Claude Code OAuth token from `claude setup-token`
# (store it as a GitHub Actions secret and pass it to the action).
CLAUDE_CODE_OAUTH_TOKEN=your_claude_code_oauth_token_here
# Alternative: a standard Anthropic API key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model (defaults to claude-opus-4-8).
CLAUDE_MODEL=claude-opus-4-8

# Optional: cache directory for fetched EIP/spec docs.
REVIEWER_CACHE_DIR=
